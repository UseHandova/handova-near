{
  "name": "handova-near",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config web/vite.config.ts",
    "typecheck": "tsc -p web/tsconfig.json && tsc -p server/tsconfig.json",
    "server": "bun run server/index.ts",
    "start": "bun run server/index.ts",
    "demo": "bun run scripts/demo-testnet.ts",
    "test:near": "bun test server/near/",
    "contract:build": "cd contract && cargo near build non-reproducible-wasm",
    "contract:test": "cd contract && cargo test",
    "deploy:testnet": "./scripts/deploy-testnet.sh",
    "build": "vite build --config web/vite.config.ts",
    "setup:testnet": "./scripts/setup-testnet.sh",
    "demo:testnet": "bun run scripts/demo-testnet.ts",
    "verify:live": "bun run scripts/verify-live.ts",
    "setup:e2e": "TIMEOUT_SECS=20 OUT=deploy/testnet.e2e.json ENV_OUT=.env.e2e ./scripts/setup-testnet.sh",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@hot-labs/near-connect": "0.12.0",
    "@noble/curves": "2.2.0",
    "@noble/hashes": "2.2.0",
    "borsh": "2.0.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "lucide-react": "^0.468.0",
    "multer": "^2.4.0",
    "near-api-js": "7.4.0",
    "qrcode": "1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/bun": "^1.4.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~7.0.2",
    "vite": "^6.0.5",
    "vite-plugin-node-polyfills": "^0.22.0"
  }
}
